{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "ONNXRUNTIME_NODE_INSTALL_CUDA=skip ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/handler?__path=:path*" }],
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/**",
      "excludeFiles": "node_modules/{@huggingface,onnxruntime-*,sharp,@img,electron*,app-builder-*}/**"
    }
  }
}
