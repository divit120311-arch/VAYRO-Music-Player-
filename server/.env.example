# Jamendo developer credentials — register at https://devportal.jamendo.com/
# The client ID stays on the server; the browser never sees it.
JAMENDO_CLIENT_ID=

# Optional: port for the API server (default 8787)
PORT=8787

# Optional: how Vayro identifies itself to LRCLIB (lyrics). Their docs ask for
# "AppName vX (homepage or contact)". Put your own deployment URL or contact here.
LRCLIB_USER_AGENT=

# ---- Full-length songs (all optional) -----------------------------------------------
# Spotify app client ID (public; no secret needed — sign-in uses OAuth with PKCE).
# developer.spotify.com/dashboard → Create app → Redirect URIs: http://127.0.0.1:5173/ and
# http://127.0.0.1:8787/ (Spotify doesn't accept "localhost") → APIs: Web API + Web Playback SDK.
# Development mode: you + up to 5 users you add under "User Management". Premium required.
SPOTIFY_CLIENT_ID=
