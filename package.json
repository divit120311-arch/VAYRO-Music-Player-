{
  "name": "vayro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,yellow \"node --watch server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "catalog:build": "node server/catalog/build.mjs",
    "typecheck": "tsc -b",
    "app:dev": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "framer-motion": "^14.13.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "description": "Vayro — music with ambient edge lighting and time-synced lyrics",
  "author": "Vayro",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.vayro.desktop",
    "productName": "Vayro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "package.json",
      "electron/**",
      "dist/**",
      "server/**",
      "!server/.cache/**",
      "!server/.env",
      "!node_modules/@huggingface/transformers/.cache/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Vayro reads which song the Spotify app (or Music) is playing, and its position, to show that song’s lyrics in time."
      },
      "identity": "-",
      "files": [
        "package.json",
        "electron/**",
        "dist/**",
        "server/**",
        "!server/.cache/**",
        "!server/.env",
        "!node_modules/@huggingface/transformers/.cache/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/**"
      ]
    },
    "dmg": {
      "title": "Vayro"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "package.json",
        "electron/**",
        "dist/**",
        "server/**",
        "!server/.cache/**",
        "!server/.env",
        "!node_modules/@huggingface/transformers/.cache/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Vayro",
      "artifactName": "Vayro-windows-setup.exe"
    }
  }
}
